+}
+
+int
+setnice(int pid, int value)
+{
+	struct proc *p;
+	if(value < 0 || value > 10) return -1;
+
+	p = find_process(pid);
+	if(!p) return -1;
+	p->priority = value;
+	return 0;
+}
+
+int
+getnice(int pid)
+{
+	struct proc *p;
+	p = find_process(pid);
+       if(!p) return -1;
+	return p->priority;
+
+}
+
+int
+ps(void)
+{
+  struct proc *p;
+  // 프로세스 상태 문자열 정의 (proc.h의 enum procstate와 매핑)
+  static char *states[] = {
+  [UNUSED]   "UNUSED  ",
+  [EMBRYO]   "EMBRYO  ",
+  [SLEEPING] "SLEEPING",
+  [RUNNABLE] "RUNNABLE",
+  [RUNNING]  "RUNNING ",
+  [ZOMBIE]   "ZOMBIE  "
+  };
+  char *state_str;
+
+  cprintf("NAME\tPID\tSTATE\t\tPRIORITY\tRUNTIME\tTICK\n");
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state == UNUSED)
+      continue;
+
+    if(p->state >= 0 && p->state < NELEM(states) && states[p->state])
+      state_str = states[p->state];
+            p->name, p->pid, state_str, p->priority, p->runtime, p->ticks);
+  }
+  release(&ptable.lock);
+
+  return 0;
+}	
