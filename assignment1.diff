+struct proc* find_process(int pid){
+	
+	struct proc *p;
+	acquire(&ptable.lock);
+	for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+		if(p->state != UNUSED && p->pid == pid){
+			
+			release(&ptable.lock);
+			return p;
+		}
+	}
+	release(&ptable.lock);
+	return 0;
+
+	
